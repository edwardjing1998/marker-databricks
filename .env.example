# Gateway-only local development example. Never commit real credentials.
# Load with your secret-management tool; the application does not auto-read .env.
DATABRICKS_HOST=https://YOUR-WORKSPACE.azuredatabricks.net
DATABRICKS_AUTH_TYPE=oauth-m2m
DATABRICKS_CLIENT_ID=YOUR_DATABRICKS_SERVICE_PRINCIPAL_APPLICATION_ID
DATABRICKS_CLIENT_SECRET=YOUR_DATABRICKS_OAUTH_SECRET_VALUE
DATABRICKS_JOB_ID=123456789
AZURE_STORAGE_CONTAINER=education
AZURE_STORAGE_SOURCE_PREFIX=source/
AZURE_STORAGE_OUTPUT_PREFIX=generated/
GPU_FALLBACK_ENABLED=false
# Bind local uvicorn to 127.0.0.1. The gateway has no client API key.
