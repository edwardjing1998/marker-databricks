# NON-SECRET GitHub development environment variables. Replace and verify examples.
OPENSHIFT_SERVER=https://api.rm1.0a51.p1.openshiftapps.com:6443
OPENSHIFT_NAMESPACE=YOUR_OPENSHIFT_PROJECT
DATABRICKS_HOST=https://YOUR-WORKSPACE.azuredatabricks.net
AZURE_STORAGE_ENDPOINT=https://chat8gpteducationaccount.blob.core.windows.net
SOURCE_VOLUME_PATH=/Volumes/education_rag/document_processing/marker_source
OUTPUT_VOLUME_PATH=/Volumes/education_rag/document_processing/marker_generated
STATE_VOLUME_PATH=/Volumes/education_rag/document_processing/marker_state
GHCR_USERNAME=YOUR_GITHUB_USERNAME

AZURE_STORAGE_CONTAINER=education
AZURE_STORAGE_SOURCE_PREFIX=source/
AZURE_STORAGE_OUTPUT_PREFIX=generated/
DATABRICKS_ENVIRONMENT_VERSION=6
GPU_FALLBACK_ENABLED=false
JOB_COMPUTE_MODE=cpu
JOB_DEFAULT_DRY_RUN=true
JOB_MAX_FILES=1
JOB_SCHEDULE_PAUSE_STATUS=PAUSED
# Leave JOB_SCHEDULE_CRON unset for no schedule.
# OAuth auth types are fixed by the workflow; do not add PAT settings.
# Client ID and client secret go in GitHub SECRETS, not this file.

# Optional tuning; leave defaults for first test.
# CPU_MAX_PAGES=20
# CPU_MAX_FILE_MB=20
# CPU_TIMEOUT_SECONDS=900
# CPU_MAX_RSS_MB=6000
# MAX_FILE_MB=200
# MAX_DOCUMENT_PAGES=5000
# MAX_SCAN_FILES=10000
# JOB_TIMEOUT_SECONDS=21600
# MARKER_CACHE_REVISION=cpu-first-v3
# DATABRICKS_GPU_ACCELERATOR=GPU_1xA10
# GPU_TIMEOUT_SECONDS=7200
# GPU_WAIT_SECONDS=7800
# DATABRICKS_SECRET_SCOPE=marker-databricks
# JOB_SCHEDULE_TIMEZONE=America/Los_Angeles
# DATABRICKS_RUN_AS_SERVICE_PRINCIPAL=OPTIONAL_DIFFERENT_APPLICATION_ID
